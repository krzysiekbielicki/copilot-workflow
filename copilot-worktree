#!/usr/bin/env bash
set -euo pipefail

trap 'true' EXIT

ORIGINAL_DIR=$(pwd)
RETURN_DIR="$ORIGINAL_DIR"
CREATED_WORKTREE=false
WORKTREE_PATH=""

# ── Check gum dependency ──────────────────────────────────────────────────────
check_gum_installed() {
    if ! command -v gum &> /dev/null; then
        cat >&2 << 'EOF'
Error: gum is not installed.

gum is a charming shell microframework that provides interactive utilities
for the command line. This script uses gum for interactive menus and prompts.

To install gum, run one of the following commands:

  With Homebrew (macOS/Linux):
    brew install gum

  With wget:
    curl https://repo.charm.sh/install | bash

  For other installation methods, visit:
    https://github.com/charmbracelet/gum

Please install gum and try again.
EOF
        exit 1
    fi
}

check_gum_installed

# Returns 0 when running inside a linked (non-main) worktree.
is_linked_worktree() {
    local git_dir common_dir
    git_dir="$(git rev-parse --git-dir 2>/dev/null || true)"
    common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
    [[ -n "$git_dir" && -n "$common_dir" && "$git_dir" != "$common_dir" ]]
}

# Prints two lines:
# 1) current worktree root containing $PWD
# 2) primary worktree root (first entry from `git worktree list`)
detect_worktree_roots() {
    local cwd="$PWD"
    local line path
    local current_root=""
    local primary_root=""

    while IFS= read -r line; do
        if [[ "$line" =~ ^worktree\ (.+)$ ]]; then
            path="${BASH_REMATCH[1]}"
            if [[ -z "$primary_root" ]]; then
                primary_root="$path"
            fi
            if [[ "$cwd" == "$path" || "$cwd" == "$path/"* ]]; then
                # Prefer the most specific match (longest path)
                if [[ -z "$current_root" || ${#path} -gt ${#current_root} ]]; then
                    current_root="$path"
                fi
            fi
        fi
    done < <(git worktree list --porcelain)

    [[ -z "$current_root" ]] && current_root="$cwd"
    [[ -z "$primary_root" ]] && primary_root="$current_root"

    printf '%s\n%s\n' "$current_root" "$primary_root"
}

# ── Helper: Check if all commits of a branch are on remote ──────────────────
# Returns 0 (true) if all commits in the branch exist somewhere on the remote
# (they may have been merged to other branches)
all_commits_on_remote() {
    local branch_name="$1"
    # Get the commit hash of the branch
    local branch_commit
    branch_commit=$(git rev-parse "$branch_name" 2>/dev/null) || return 1
    
    # Refresh remote refs to make ancestry checks accurate
    git fetch origin --quiet 2>/dev/null || true
    
    # Verify the commit is actually on remote by checking if it's reachable from origin refs.
    if git show-ref --verify --quiet refs/remotes/origin/HEAD; then
        git merge-base --is-ancestor "$branch_commit" origin/HEAD 2>/dev/null && return 0
    fi

    while IFS= read -r ref; do
        [[ "$ref" == "origin/HEAD" ]] && continue
        git merge-base --is-ancestor "$branch_commit" "$ref" 2>/dev/null && return 0
    done < <(git for-each-ref --format='%(refname:short)' refs/remotes/origin/ 2>/dev/null)

    return 1
}

# ── Arrow-key menu using gum ──────────────────────────────────────────────────
# Usage: menu <result_var> <prompt> <option1> <option2> ...
# Sets result_var to the chosen option string.
menu() {
    local _var="$1"; shift
    local _prompt="$1"; shift
    local _opts=("$@")

    local _choice
    _choice=$(gum choose --header="$_prompt" "${_opts[@]}")
    
    printf -v "$_var" '%s' "$_choice"
}

cleanup_and_return() {
    local worktree_path="$1"
    local created="$2"
    local action="${3:-switch}"  # switch, stay, or delete

    case "$action" in
        stay)
            echo "Staying in worktree at: $worktree_path"
            cd "$worktree_path"
            exec "$SHELL"
            ;;
        delete)
            cd "$RETURN_DIR"
            if [[ "$created" == true ]]; then
                echo "Removing worktree: $worktree_path"
                git worktree remove --force "$worktree_path"
            fi
            if [[ -n "${CHOSEN_BRANCH:-}" && "${BRANCH_EXISTS:-true}" == false ]]; then
                git branch -D "$CHOSEN_BRANCH"
                echo "Branch $CHOSEN_BRANCH deleted."
            fi
            return 0
            ;;
        switch)
            cd "$RETURN_DIR"
            if [[ "$created" == true ]]; then
                echo "Removing worktree: $worktree_path"
                git worktree remove --force "$worktree_path"
            fi
            if [[ -n "${CHOSEN_BRANCH:-}" ]]; then
                git checkout "$CHOSEN_BRANCH"
            fi
            return 0
            ;;
    esac
}

# ── Helper: Check if worktree has uncommitted changes ─────────────────────────
is_worktree_dirty() {
    # Check for uncommitted changes: staged, unstaged, or untracked files
    if git diff --quiet && git diff --cached --quiet && [[ -z "$(git ls-files --others --exclude-standard)" ]]; then
        return 1  # clean
    else
        return 0  # dirty
    fi
}

# ── Helper: Check if branch has unpushed commits ─────────────────────────────
has_unpushed_commits() {
    local upstream
    upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)" || true
    if [[ -z "$upstream" ]]; then
        # No upstream set – any local commits count as unpushed
        [[ -n "$(git log --oneline -1 2>/dev/null)" ]] && return 0 || return 1
    fi
    # Upstream exists – check if there are commits ahead
    [[ -n "$(git log --oneline "$upstream..HEAD" 2>/dev/null)" ]]
}

# ── Helper: Check if a specific branch has unpushed commits ────────────────────
branch_has_unpushed_commits() {
    local branch_name="$1"
    local upstream
    upstream="$(git rev-parse --abbrev-ref --symbolic-full-name "${branch_name}@{u}" 2>/dev/null)" || true
    if [[ -z "$upstream" ]]; then
        return 0
    fi
    [[ -n "$(git log --oneline "$upstream..$branch_name" 2>/dev/null)" ]]
}

# ── Helper: Branch can be safely recreated from remote ─────────────────────────
is_branch_recoverable() {
    local branch_name="$1"
    local upstream
    upstream="$(git rev-parse --abbrev-ref --symbolic-full-name "${branch_name}@{u}" 2>/dev/null)" || true
    [[ -n "$upstream" ]] && ! branch_has_unpushed_commits "$branch_name"
}

# ── Helper: Push branch and optionally create PR ─────────────────────────────
push_branch() {
    local branch_name="$1"

    echo "Pushing to origin/$branch_name..."
    if ! git push -u origin "$branch_name"; then
        echo "Push failed."
        return 1
    fi

    # Offer to create a pull request if gh CLI is available
    if command -v gh &> /dev/null; then
        echo
        local _pr_choice=""
        menu _pr_choice "Create a pull request for $branch_name?" \
            "Yes, create PR" \
            "No, skip PR creation"

        if [[ "$_pr_choice" == "Yes, create PR" ]]; then
            echo "Creating pull request..."
            if gh pr create --fill; then
                echo "✓ Pull request created successfully!"
            else
                local _pr_status=$?
                if (( _pr_status == 1 )); then
                    echo "⚠ PR creation cancelled or user not authenticated."
                else
                    echo "⚠ PR creation failed (exit code: $_pr_status)."
                fi
                echo "Note: Branch has been pushed successfully. You can create the PR manually later."
            fi
        fi
    fi

    return 0
}

# ── Helper: Find existing worktree for a given branch ────────────────────────
find_worktree_for_branch() {
    local branch_name="$1"
    
    local worktree_path=""
    local current_worktree_path=""
    
    # Parse git worktree list --porcelain output
    # Format has multiple lines per worktree: worktree, HEAD, branch, etc.
    while IFS= read -r line; do
        if [[ "$line" =~ ^worktree\ (.+)$ ]]; then
            # Start of a new worktree entry
            current_worktree_path="${BASH_REMATCH[1]}"
        elif [[ "$line" =~ ^branch\ refs/heads/(.+)$ ]]; then
            # Found branch reference in current worktree
            local current_branch="${BASH_REMATCH[1]}"
            
            # Check if this is the branch we're looking for
            if [[ "$current_branch" == "$branch_name" ]]; then
                # Verify the path still exists (handle stale worktree entries)
                if [[ -d "$current_worktree_path" ]]; then
                    worktree_path="$current_worktree_path"
                    break
                fi
            fi
        fi
    done < <(git worktree list --porcelain)
    
    printf '%s' "$worktree_path"
}

# ── Helper: Confirm destructive operations with user ──────────────────────────
confirm_destructive_operation() {
    local operation="$1"
    local branch_exists="${2:-true}"
    local branch_name="${3:-}"
    
    # For existing branches, check if all commits are on remote
    if [[ "$branch_exists" == true && -n "$branch_name" ]]; then
        # If all commits are on remote (even if branch was merged and deleted), skip confirmation
        if all_commits_on_remote "$branch_name"; then
            echo "All commits found on remote. Proceeding without confirmation..."
            return 0
        fi

        local upstream
        upstream="$(git rev-parse --abbrev-ref --symbolic-full-name "${branch_name}@{u}" 2>/dev/null)" || true

        echo
        echo "⚠️  $operation"
        echo
        echo "Branch Information:"
        git log -1 --oneline "$branch_name" | sed 's/^/  /'
        echo

        if is_branch_recoverable "$branch_name"; then
            echo "ℹ️  This branch is fully pushed to $upstream."
            echo "You can recreate it later from remote if needed."
            echo
            local _confirm=""
            menu _confirm "Delete local branch $branch_name and remove worktree?" \
                "Yes, delete local branch" \
                "No, keep it"
        else
            if [[ -n "$upstream" ]]; then
                echo "⚠️  This branch has local commits not pushed to $upstream."
            else
                echo "⚠️  This branch has no upstream remote configured."
            fi
            echo "Deleting it now may make your local commits hard to recover."
            echo
            local _confirm=""
            menu _confirm "Delete $branch_name permanently?" \
                "Yes, delete permanently" \
                "No, keep it"
        fi
    else
        # For new branches, simpler message
        echo
        echo "⚠️  $operation"
        echo
        echo "This will delete the branch and remove the worktree. This cannot be undone."
        echo
        local _confirm=""
        menu _confirm "Proceed?" \
            "Yes, drop it" \
            "No, keep it"
    fi
    
    if [[ "$_confirm" =~ ^Yes ]]; then
        return 0
    else
        return 1
    fi
}

# ── Helper: Remove worktree directory ────────────────────────────────────────
cleanup_worktree() {
    local worktree_path="$1"
    local original_dir="$2"
    
    cd "$original_dir"
    if [[ -d "$worktree_path" ]]; then
        echo "Removing worktree: $worktree_path"
        git worktree remove --force "$worktree_path"
    fi
    
    return 0
}

# ── Helper: Return user to original repo root after cleanup ───────────────────
return_to_repo_root() {
    cd "$RETURN_DIR"
    echo "Returned to repository root: $RETURN_DIR"
    if [[ -t 0 && -t 1 ]]; then
        exec "$SHELL"
    fi
    return 0
}

# ── Helper: Push changes and optionally create PR ─────────────────────────────
push_and_cleanup() {
    local worktree_path="$1"
    local original_dir="$2"
    local branch_name="$3"
    
    # Stage all changes
    echo "Staging all changes..."
    git add -A
    
    # Prompt for commit message
    read -rp "Commit message: " commit_msg
    if [[ -z "$commit_msg" ]]; then
        echo "Commit message cannot be empty. Aborting."
        return 1
    fi
    
    # Commit changes
    echo "Committing changes..."
    git commit -m "$commit_msg"
    
    # Push and offer PR
    if ! push_branch "$branch_name"; then
        echo "Aborting cleanup."
        return 1
    fi
    
    # Clean up the worktree
    cleanup_worktree "$worktree_path" "$original_dir"
    
    return 0
}

# ── Unified session cleanup menu ────────────────────────────────────────────
# Auto-detects dirty/clean state and presents appropriate menu options.
# Parameters:
#   $1: worktree_path
#   $2: created (true/false)
#   $3: optional forced state ('dirty' or 'clean') for testing
session_cleanup_menu() {
    local worktree_path="$1"
    local created="$2"
    local forced_state="${3:-}"  # optional: 'dirty' or 'clean' for testing
    
    # Determine if worktree is dirty or clean
    local is_dirty=false
    if [[ -n "$forced_state" ]]; then
        # For testing: use forced state
        [[ "$forced_state" == "dirty" ]] && is_dirty=true
    else
        # Auto-detect: call is_worktree_dirty (returns 0 if dirty)
        if is_worktree_dirty; then
            is_dirty=true
        fi
    fi
    
    if [[ "$is_dirty" == true ]]; then
        # ── DIRTY WORKTREE MENU ──────────────────────────────────────────────
        echo
        echo "Worktree has uncommitted changes:"
        git status --short
        echo
        
        # Build dirty menu options
        local _dirty_opts=(
            "Stay in worktree with changes"
            "Commit changes"
            "Push and remove worktree"
        )
        
        # Add delete option based on BRANCH_EXISTS
        if [[ "${BRANCH_EXISTS:-true}" == false ]]; then
            _dirty_opts+=("Discard changes and remove worktree")
        else
            _dirty_opts+=("Discard changes, delete branch, and remove worktree")
        fi
        
        local _dirty_choice
        menu _dirty_choice "Worktree has uncommitted changes. What would you like to do?" "${_dirty_opts[@]}"
        
        case "$_dirty_choice" in
            "Stay in worktree with changes")
                echo "Staying in worktree with uncommitted changes at: $worktree_path"
                cd "$worktree_path"
                exec "$SHELL"
                ;;
            "Commit changes")
                git add -A
                read -rp "Commit message: " commit_msg
                if [[ -z "$commit_msg" ]]; then
                    echo "Commit cancelled."
                    # Re-show menu
                    session_cleanup_menu "$worktree_path" "$created" "$forced_state"
                    return
                fi
                git commit -m "$commit_msg"
                echo "Changes committed successfully."
                # After commit, show clean menu
                session_cleanup_menu "$worktree_path" "$created" "clean"
                ;;
            "Push and remove worktree")
                push_and_cleanup "$worktree_path" "$RETURN_DIR" "$CHOSEN_BRANCH"
                echo "Worktree removed."
                return_to_repo_root
                exit 0
                ;;
            "Discard changes and remove worktree")
                # Destructive: confirm first
                if confirm_destructive_operation "About to drop all changes and delete the branch." "$BRANCH_EXISTS" "$CHOSEN_BRANCH"; then
                    cd "$RETURN_DIR"
                    git worktree remove --force "$worktree_path"
                    if [[ "${BRANCH_EXISTS:-true}" == false ]]; then
                        git branch -D "$CHOSEN_BRANCH"
                        echo "Branch $CHOSEN_BRANCH deleted."
                    fi
                    echo "Worktree cleaned up."
                    return_to_repo_root
                    exit 0
                else
                    echo "Operation cancelled. Returning to menu."
                    session_cleanup_menu "$worktree_path" "$created" "dirty"
                fi
                ;;
            "Discard changes, delete branch, and remove worktree")
                # Destructive: confirm first
                if confirm_destructive_operation "About to drop all changes and delete branch $CHOSEN_BRANCH." "$BRANCH_EXISTS" "$CHOSEN_BRANCH"; then
                    cd "$RETURN_DIR"
                    git worktree remove --force "$worktree_path"
                    git branch -D "$CHOSEN_BRANCH"
                    echo "Branch $CHOSEN_BRANCH deleted and worktree cleaned up."
                    return_to_repo_root
                    exit 0
                else
                    echo "Operation cancelled. Returning to menu."
                    session_cleanup_menu "$worktree_path" "$created" "dirty"
                fi
                ;;
        esac
    else
        # ── CLEAN WORKTREE MENU ──────────────────────────────────────────────
        # Build clean menu options
        local _clean_opts=(
            "Stay in worktree"
        )

        # Add push option if there are unpushed commits
        if has_unpushed_commits; then
            _clean_opts+=("Push and remove worktree")
        fi

        _clean_opts+=("Remove worktree (keep branch)")
        _clean_opts+=("Remove worktree and delete branch")
        
        local _clean_choice
        menu _clean_choice "What next?" "${_clean_opts[@]}"
        
        case "$_clean_choice" in
            "Stay in worktree")
                echo "Staying in worktree at: $worktree_path"
                cd "$worktree_path"
                exec "$SHELL"
                ;;
            "Push and remove worktree")
                if push_branch "$CHOSEN_BRANCH"; then
                    cleanup_worktree "$worktree_path" "$RETURN_DIR"
                    echo "Worktree removed."
                    return_to_repo_root
                    exit 0
                else
                    echo "Push failed. Returning to menu."
                    session_cleanup_menu "$worktree_path" "$created" "clean"
                fi
                ;;
            "Remove worktree (keep branch)")
                cleanup_worktree "$worktree_path" "$RETURN_DIR"
                echo "Worktree removed. Branch $CHOSEN_BRANCH kept."
                return_to_repo_root
                exit 0
                ;;
            "Remove worktree and delete branch")
                # Skip confirmation when branch is recoverable from remote
                if [[ "${BRANCH_EXISTS:-true}" == true ]] && is_branch_recoverable "$CHOSEN_BRANCH"; then
                    cd "$RETURN_DIR"
                    git worktree remove --force "$worktree_path"
                    git branch -D "$CHOSEN_BRANCH"
                    echo "Branch $CHOSEN_BRANCH deleted and worktree cleaned up."
                    return_to_repo_root
                    exit 0
                else
                    # Destructive: confirm first when branch is not recoverable
                    if confirm_destructive_operation "About to delete branch $CHOSEN_BRANCH and clean up worktree." "$BRANCH_EXISTS" "$CHOSEN_BRANCH"; then
                        cd "$RETURN_DIR"
                        git worktree remove --force "$worktree_path"
                        git branch -D "$CHOSEN_BRANCH"
                        echo "Branch $CHOSEN_BRANCH deleted and worktree cleaned up."
                        return_to_repo_root
                        exit 0
                    else
                        echo "Operation cancelled. Returning to menu."
                        session_cleanup_menu "$worktree_path" "$created" "clean"
                    fi
                fi
                ;;
        esac
    fi
}

# ── No git repo → just run copilot ──────────────────────────────────────────
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Not inside a git repository — launching copilot directly."
    copilot "$@"
    exit 0
fi

# Normalize directories for git repos:
# - ORIGINAL_DIR: current worktree root (for naming and branch context)
# - RETURN_DIR: primary worktree root (first entry from `git worktree list`)
_roots_output="$(detect_worktree_roots)"
ORIGINAL_DIR="$(printf '%s\n' "$_roots_output" | sed -n '1p')"
RETURN_DIR="$(printf '%s\n' "$_roots_output" | sed -n '2p')"
[[ -z "$RETURN_DIR" ]] && RETURN_DIR="$ORIGINAL_DIR"
cd "$ORIGINAL_DIR"

# ── Ask whether to use a different branch ───────────────────────────────────
current_branch=$(git rev-parse --abbrev-ref HEAD)
CHOSEN_BRANCH=""

# ── Branch chooser using gum filter ──────────────────────────────────────────
# Replaces manual filtering implementation with gum filter for better UX.
# Allows fuzzy matching, custom branch names, and maintains same interface.
_branch_menu() {
    local _var="$1"; shift
    local _prompt="$1"; shift
    local _all_branches=("$@")

    local _output
    _output=$(printf '%s\n' "${_all_branches[@]+"${_all_branches[@]}"}" | gum filter \
        --header="$_prompt" \
        --placeholder="Type to filter or create new branch..." \
        --no-strict)

    local _match_found=false
    for branch in "${_all_branches[@]+"${_all_branches[@]}"}"; do
        if [[ "$_output" == "$branch" ]]; then
            _match_found=true
            break
        fi
    done

    if [[ "$_match_found" == true ]]; then
        printf -v "$_var" '%s' "$_output"
    else
        printf -v "$_var" 'MANUAL:%s' "$_output"
    fi
}

sanitize_branch_name() {
    local name="$1"
    # Replace spaces with hyphens
    name="${name// /-}"
    # Replace backslashes with forward slashes
    name="${name//\\//}"
    # Remove forbidden git-ref characters: ~ ^ : ? * [ ] control-chars DEL
    name=$(printf '%s' "$name" | tr -d '[:cntrl:]' | sed 's/[]~^:?*\[\\]//g')
    # Remove .. sequences
    while [[ "$name" == *..* ]]; do name="${name/../.}"; done
    # Remove @{…} sequences (forbidden in git refs)
    name=$(printf '%s' "$name" | sed 's/@{[^}]*}//g')
    # Collapse consecutive slashes
    while [[ "$name" == *//* ]]; do name="${name/\/\///}"; done
    # Collapse consecutive hyphens
    while [[ "$name" == *--* ]]; do name="${name/--/-}"; done
    # Per-component cleanup: strip .lock suffix and leading dots from each path component
    local IFS='/' components=() c cleaned=()
    read -ra components <<< "$name"
    for c in "${components[@]}"; do
        # Remove .lock suffix from component (repeatedly for .lock.lock etc.)
        while [[ "$c" == *.lock ]]; do c="${c%.lock}"; done
        # Strip leading dots from component
        while [[ "$c" == .* ]]; do c="${c#.}"; done
        [[ -n "$c" ]] && cleaned+=("$c")
    done
    name=$(printf '%s\n' "${cleaned[*]}")
    # Strip leading/trailing dots, hyphens, slashes (all of them)
    while [[ "$name" == [./-]* ]]; do name="${name#[./-]}"; done
    while [[ "$name" == *[./-] ]]; do name="${name%[./-]}"; done

    printf '%s' "$name"
}

choose_branch() {
    local all_branches=()
    while IFS= read -r b; do
        [[ "$b" != "$current_branch" ]] && all_branches+=("$b")
    done < <(git branch --sort=-committerdate --format='%(refname:short)' 2>/dev/null)

    while true; do
        local result=""
        _branch_menu result "Select branch:" ${all_branches[@]+"${all_branches[@]}"}

        case "$result" in
            MANUAL:*)
                local raw_name="${result#MANUAL:}"
                local sanitized
                sanitized=$(sanitize_branch_name "$raw_name")

                if [[ -z "$sanitized" ]] || ! git check-ref-format "refs/heads/$sanitized" 2>/dev/null; then
                    echo "Branch name is invalid after sanitization. Please try again."
                    continue
                fi

                if [[ "$sanitized" != "$raw_name" ]]; then
                    local _confirm=""
                    echo "Proposed name: $sanitized"
                    menu _confirm "Invalid characters detected. What would you like to do?" \
                        "Use proposed name" \
                        "Let me type again"
                    case "$_confirm" in
                        "Use proposed name")
                            CHOSEN_BRANCH="$sanitized"
                            ;;
                        "Let me type again")
                            continue
                            ;;
                    esac
                else
                    CHOSEN_BRANCH="$raw_name"
                fi
                ;;
            "")
                echo "No branch selected. Exiting."
                exit 1
                ;;
            *)
                CHOSEN_BRANCH="$result"
                ;;
        esac
        break
    done
}

_worktree_choice=""
menu _worktree_choice "Run Copilot in a different branch?" \
    "Run Copilot here" \
    "Use a different branch"

case "$_worktree_choice" in
    "Run Copilot here")
        echo "Launching copilot in current directory..."
        echo
        copilot "$@" || true
        if is_linked_worktree; then
            CHOSEN_BRANCH="$current_branch"
            BRANCH_EXISTS=true
            WORKTREE_PATH="$ORIGINAL_DIR"
            CREATED_WORKTREE=false
            cd "$WORKTREE_PATH"
            session_cleanup_menu "$WORKTREE_PATH" "$CREATED_WORKTREE"
        fi
        exit 0
        ;;
    "Use a different branch")
        choose_branch
        ;;
esac

if [[ -z "$CHOSEN_BRANCH" ]]; then
    echo "No branch selected. Exiting."
    exit 1
fi

# Determine if the chosen branch already exists locally
if git rev-parse --verify "$CHOSEN_BRANCH" > /dev/null 2>&1; then
    BRANCH_EXISTS=true
else
    BRANCH_EXISTS=false
fi

echo "Using branch: $CHOSEN_BRANCH"
current_dir_name="${ORIGINAL_DIR##*/}"
parent_dir="$(dirname "$ORIGINAL_DIR")"
worktree_name="$current_dir_name-${CHOSEN_BRANCH//\//_}"
WORKTREE_PATH="$parent_dir/$worktree_name"

# ── Check if the branch is already checked out in an existing worktree ────────
existing_worktree=$(find_worktree_for_branch "$CHOSEN_BRANCH")
if [[ -n "$existing_worktree" ]]; then
    echo "Branch is already checked out in: $existing_worktree"
    WORKTREE_PATH="$existing_worktree"
    CREATED_WORKTREE=false
    cd "$WORKTREE_PATH"
else
    # Branch is not in any existing worktree, proceed with normal creation
    worktree_add() {
        local path="$1" branch="$2"
        if [[ "$BRANCH_EXISTS" == true ]]; then
            git worktree add "$path" "$branch"
        else
            git worktree add -b "$branch" "$path"
        fi
    }

    # ── Handle existing directory ────────────────────────────────────────────────
    if [[ -e "$WORKTREE_PATH" ]]; then
        echo "Directory already exists: $WORKTREE_PATH"
        _exist_choice=""
        menu _exist_choice "What would you like to do?" \
            "Use existing directory" \
            "Create new with timestamp" \
            "Exit"
        case "$_exist_choice" in
            "Exit")
                exit 0
                ;;
            "Use existing directory")
                CREATED_WORKTREE=false
                cd "$WORKTREE_PATH"
                ;;
            "Create new with timestamp")
                timestamp=$(date +%Y%m%d%H%M%S)
                worktree_name="$current_dir_name-$CHOSEN_BRANCH-$timestamp"
                WORKTREE_PATH="$parent_dir/$worktree_name"
                worktree_add "$WORKTREE_PATH" "$CHOSEN_BRANCH"
                CREATED_WORKTREE=true
                cd "$WORKTREE_PATH"
                ;;
        esac
    else
        worktree_add "$WORKTREE_PATH" "$CHOSEN_BRANCH"
        CREATED_WORKTREE=true
        cd "$WORKTREE_PATH"
    fi
fi


echo "Worktree ready at: $WORKTREE_PATH"
echo "Launching copilot..."
echo

# ── Run copilot ──────────────────────────────────────────────────────────────
copilot --add-dir "$WORKTREE_PATH" "$@" || true  # don't exit on non-zero exit from copilot

# ── Post-copilot cleanup ─────────────────────────────────────────────────────
cd "$WORKTREE_PATH"
session_cleanup_menu "$WORKTREE_PATH" "$CREATED_WORKTREE"
