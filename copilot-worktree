#!/usr/bin/env bash
set -euo pipefail

trap 'true' EXIT

ORIGINAL_DIR=$(pwd)
CREATED_WORKTREE=false
WORKTREE_PATH=""

# ── Check gum dependency ──────────────────────────────────────────────────────
check_gum_installed() {
    if ! command -v gum &> /dev/null; then
        cat >&2 << 'EOF'
Error: gum is not installed.

gum is a charming shell microframework that provides interactive utilities
for the command line. This script uses gum for interactive menus and prompts.

To install gum, run one of the following commands:

  With Homebrew (macOS/Linux):
    brew install gum

  With wget:
    curl https://repo.charm.sh/install | bash

  For other installation methods, visit:
    https://github.com/charmbracelet/gum

Please install gum and try again.
EOF
        exit 1
    fi
}

check_gum_installed

# ── Arrow-key menu using gum ──────────────────────────────────────────────────
# Usage: menu <result_var> <prompt> <option1> <option2> ...
# Sets result_var to the chosen option string.
menu() {
    local _var="$1"; shift
    local _prompt="$1"; shift
    local _opts=("$@")

    local _choice
    _choice=$(gum choose --header="$_prompt" "${_opts[@]}")
    
    printf -v "$_var" '%s' "$_choice"
}

cleanup_and_return() {
    local worktree_path="$1"
    local created="$2"

    cd "$ORIGINAL_DIR"

    if [[ "$created" == false ]]; then
        echo "Worktree at $worktree_path preserved (not created by this session)."
        return
    fi

    echo "Removing worktree: $worktree_path"
    git worktree remove --force "$worktree_path"

    if [[ -n "${CHOSEN_BRANCH:-}" ]]; then
        local _switch_opts=("Yes, switch to $CHOSEN_BRANCH" "No, stay on $current_branch")
        if [[ "${BRANCH_EXISTS:-true}" == false ]]; then
            _switch_opts+=("Delete $CHOSEN_BRANCH branch (drop all changes done in this session)")
        fi
        local _switch_choice
        menu _switch_choice "What next?" "${_switch_opts[@]}"
        case "$_switch_choice" in
            "Yes, switch to $CHOSEN_BRANCH")
                git checkout "$CHOSEN_BRANCH" ;;
            "Delete $CHOSEN_BRANCH branch (drop all changes done in this session)")
                git branch -D "$CHOSEN_BRANCH"
                echo "Branch $CHOSEN_BRANCH deleted." ;;
        esac
    fi
}

handle_dirty_worktree() {
    local worktree_path="$1"
    local created="$2"

    echo
    echo "Worktree has uncommitted or untracked changes:"
    git status --short
    echo

    local _dirty_opts=("Stage all and commit" "Exit (keep worktree)")
    if [[ "${BRANCH_EXISTS:-true}" == false ]]; then
        _dirty_opts+=("Delete $CHOSEN_BRANCH branch (drop all changes done in this session)")
    fi
    local _dirty_choice
    menu _dirty_choice "What would you like to do?" "${_dirty_opts[@]}"

    case "$_dirty_choice" in
        "Stage all and commit")
            git add -A
            commit_msg=$(gum input --placeholder="Commit message" --prompt="📝 ")
            git commit -m "$commit_msg"
            cleanup_and_return "$worktree_path" "$created"
            ;;
        "Exit (keep worktree)")
            echo "Leaving worktree intact at: $worktree_path"
            exit 0
            ;;
        "Delete $CHOSEN_BRANCH branch (drop all changes done in this session)")
            cd "$ORIGINAL_DIR"
            git worktree remove --force "$worktree_path"
            git branch -D "$CHOSEN_BRANCH"
            echo "Branch $CHOSEN_BRANCH deleted."
            ;;
    esac
}

# ── No git repo → just run copilot ──────────────────────────────────────────
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Not inside a git repository — launching copilot directly."
    copilot "$@"
    exit 0
fi

# ── Ask whether to use a different branch ───────────────────────────────────
current_branch=$(git rev-parse --abbrev-ref HEAD)
CHOSEN_BRANCH=""

# ── Branch chooser using gum filter ──────────────────────────────────────────
# Replaces manual filtering implementation with gum filter for better UX.
# Allows fuzzy matching, custom branch names, and maintains same interface.
_branch_menu() {
    local _var="$1"; shift
    local _prompt="$1"; shift
    local _all_branches=("$@")

    local _output
    _output=$(printf '%s\n' "${_all_branches[@]+"${_all_branches[@]}"}" | gum filter \
        --header="$_prompt" \
        --placeholder="Type to filter or create new branch..." \
        --no-strict)

    local _match_found=false
    for branch in "${_all_branches[@]+"${_all_branches[@]}"}"; do
        if [[ "$_output" == "$branch" ]]; then
            _match_found=true
            break
        fi
    done

    if [[ "$_match_found" == true ]]; then
        printf -v "$_var" '%s' "$_output"
    else
        printf -v "$_var" 'MANUAL:%s' "$_output"
    fi
}

sanitize_branch_name() {
    local name="$1"
    # Replace spaces with hyphens
    name="${name// /-}"
    # Replace backslashes with forward slashes
    name="${name//\\//}"
    # Remove forbidden git-ref characters: ~ ^ : ? * [ ] control-chars DEL
    name=$(printf '%s' "$name" | tr -d '[:cntrl:]' | sed 's/[]~^:?*\[\\]//g')
    # Remove .. sequences
    while [[ "$name" == *..* ]]; do name="${name/../.}"; done
    # Remove @{…} sequences (forbidden in git refs)
    name=$(printf '%s' "$name" | sed 's/@{[^}]*}//g')
    # Collapse consecutive slashes
    while [[ "$name" == *//* ]]; do name="${name/\/\///}"; done
    # Collapse consecutive hyphens
    while [[ "$name" == *--* ]]; do name="${name/--/-}"; done
    # Per-component cleanup: strip .lock suffix and leading dots from each path component
    local IFS='/' components=() c cleaned=()
    read -ra components <<< "$name"
    for c in "${components[@]}"; do
        # Remove .lock suffix from component (repeatedly for .lock.lock etc.)
        while [[ "$c" == *.lock ]]; do c="${c%.lock}"; done
        # Strip leading dots from component
        while [[ "$c" == .* ]]; do c="${c#.}"; done
        [[ -n "$c" ]] && cleaned+=("$c")
    done
    name=$(printf '%s\n' "${cleaned[*]}")
    # Strip leading/trailing dots, hyphens, slashes (all of them)
    while [[ "$name" == [./-]* ]]; do name="${name#[./-]}"; done
    while [[ "$name" == *[./-] ]]; do name="${name%[./-]}"; done

    printf '%s' "$name"
}

choose_branch() {
    local all_branches=()
    while IFS= read -r b; do
        [[ "$b" != "$current_branch" ]] && all_branches+=("$b")
    done < <(git branch --sort=-committerdate --format='%(refname:short)' 2>/dev/null)

    while true; do
        local result=""
        _branch_menu result "Select branch:" ${all_branches[@]+"${all_branches[@]}"}

        case "$result" in
            MANUAL:*)
                local raw_name="${result#MANUAL:}"
                local sanitized
                sanitized=$(sanitize_branch_name "$raw_name")

                if [[ -z "$sanitized" ]] || ! git check-ref-format "refs/heads/$sanitized" 2>/dev/null; then
                    echo "Branch name is invalid after sanitization. Please try again."
                    continue
                fi

                if [[ "$sanitized" != "$raw_name" ]]; then
                    local _confirm=""
                    echo "Proposed name: $sanitized"
                    menu _confirm "Invalid characters detected. Use sanitized name?" \
                        "Yes, use proposed name" \
                        "No, let me type again"
                    case "$_confirm" in
                        "Yes, use proposed name")
                            CHOSEN_BRANCH="$sanitized"
                            ;;
                        "No, let me type again")
                            continue
                            ;;
                    esac
                else
                    CHOSEN_BRANCH="$raw_name"
                fi
                ;;
            "")
                echo "No branch selected. Exiting."
                exit 1
                ;;
            *)
                CHOSEN_BRANCH="$result"
                ;;
        esac
        break
    done
}

_worktree_choice=""
menu _worktree_choice "Run Copilot in a different branch (worktree)?" \
    "No, run Copilot here" \
    "Yes, use a different branch"

case "$_worktree_choice" in
    "No, run Copilot here")
        echo "Launching copilot in current directory..."
        echo
        copilot "$@" || true
        exit 0
        ;;
    "Yes, use a different branch")
        choose_branch
        ;;
esac

if [[ -z "$CHOSEN_BRANCH" ]]; then
    echo "No branch selected. Exiting."
    exit 1
fi

# Determine if the chosen branch already exists locally
if git rev-parse --verify "$CHOSEN_BRANCH" > /dev/null 2>&1; then
    BRANCH_EXISTS=true
else
    BRANCH_EXISTS=false
fi

echo "Using branch: $CHOSEN_BRANCH"
current_dir_name="${ORIGINAL_DIR##*/}"
parent_dir=$(cd .. && pwd)
worktree_name="$current_dir_name-${CHOSEN_BRANCH//\//_}"
WORKTREE_PATH="$parent_dir/$worktree_name"

worktree_add() {
    local path="$1" branch="$2"
    if [[ "$BRANCH_EXISTS" == true ]]; then
        git worktree add "$path" "$branch"
    else
        git worktree add -b "$branch" "$path"
    fi
}

# ── Handle existing directory ────────────────────────────────────────────────
if [[ -e "$WORKTREE_PATH" ]]; then
    echo "Directory already exists: $WORKTREE_PATH"
    _exist_choice=""
    menu _exist_choice "What would you like to do?" \
        "Use existing worktree directory" \
        "Add timestamp suffix" \
        "Exit"
    case "$_exist_choice" in
        "Exit")
            exit 0
            ;;
        "Use existing worktree directory")
            CREATED_WORKTREE=false
            cd "$WORKTREE_PATH"
            ;;
        "Add timestamp suffix")
            timestamp=$(date +%Y%m%d%H%M%S)
            worktree_name="$current_dir_name-$CHOSEN_BRANCH-$timestamp"
            WORKTREE_PATH="$parent_dir/$worktree_name"
            worktree_add "$WORKTREE_PATH" "$CHOSEN_BRANCH"
            CREATED_WORKTREE=true
            cd "$WORKTREE_PATH"
            ;;
    esac
else
    worktree_add "$WORKTREE_PATH" "$CHOSEN_BRANCH"
    CREATED_WORKTREE=true
    cd "$WORKTREE_PATH"
fi

echo "Worktree ready at: $WORKTREE_PATH"
echo "Launching copilot..."
echo

# ── Run copilot ──────────────────────────────────────────────────────────────
copilot --add-dir "$WORKTREE_PATH" "$@" || true  # don't exit on non-zero exit from copilot

# ── Post-copilot cleanup ─────────────────────────────────────────────────────
cd "$WORKTREE_PATH"

if git diff --quiet && git diff --cached --quiet && [[ -z "$(git ls-files --others --exclude-standard)" ]]; then
    cleanup_and_return "$WORKTREE_PATH" "$CREATED_WORKTREE"
else
    handle_dirty_worktree "$WORKTREE_PATH" "$CREATED_WORKTREE"
fi
